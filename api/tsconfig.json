{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@workspace/db": ["../lib/db/src/index.ts"],
      "@workspace/api-zod": ["../lib/api-zod/src/index.ts"],
      "@workspace/api-client-react": ["../lib/api-client-react/src/index.ts"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules"]
}
