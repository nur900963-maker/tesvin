{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/api-server run build:vercel && pnpm --filter @workspace/dashboard run build",
  "outputDirectory": "artifacts/dashboard/dist/public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/debug.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/((?!debug).*)", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
