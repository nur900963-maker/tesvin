# ================================================================
# ENVIRONMENT VARIABLES — VINCENT WORLD MULTI
# Dev lokal: copy ke .env.local | Production: isi di Vercel →
# Project Settings → Environment Variables (Production + Preview)
# ================================================================

# ── Database: Supabase (dibaca oleh /api, server-side) ──────────
# Cukup salah satu pasangan:
#  (A) Env lama:  VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY   → langsung jalan
#      (tabel harus RLS-nonaktif, jangan jalankan 00002_enable_rls.sql)
#  (B) Disarankan: SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY    → boleh RLS aktif
# Service-role key = rahasia penuh, JANGAN diberi prefix VITE_.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ganti_dengan_anon_key
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_service_role_key

# ── Auth / Session ──────────────────────────────────────────────
# Wajib diisi di production. Random string panjang (min 32 char).
SESSION_SECRET=ganti_dengan_random_string_yang_panjang_min32char

# ── Frontend (VITE_* ikut ter-bundle ke browser = PUBLIK) ───────
# URL audio langsung (https://...mp3/.wav/.ogg). Kosong = pakai
# file bawaan /audio/ambient.wav. Bukan rahasia (terlihat di DevTools).
VITE_AUDIO_URL=

# ── Replit (dev only, jangan isi di Vercel) ─────────────────────
# PORT=3000
# BASE_PATH=/
