# ================================================================
# ENVIRONMENT VARIABLES — VINCENT WORLD MULTI
# Copy file ini ke .env.local (dev) atau isi di Vercel Dashboard
# ================================================================

# ── Database MongoDB ────────────────────────────────────────────
# Backend memakai MongoDB (Mongoose), BUKAN PostgreSQL.
# Gunakan MongoDB Atlas (gratis): https://www.mongodb.com/atlas
# Format: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── Auth / Session ──────────────────────────────────────────────
# Secret untuk tanda tangan token session, buat random string panjang (min 32 char)
SESSION_SECRET=ganti_dengan_random_string_yang_panjang_min32char

# ── Replit (dev only, jangan isi di Vercel) ─────────────────────
# PORT=3000
# BASE_PATH=/
